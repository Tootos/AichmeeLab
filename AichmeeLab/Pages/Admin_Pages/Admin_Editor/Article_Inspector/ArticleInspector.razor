@using BootstrapBlazor.Components
@using AichmeeLab.Services.ImageService
@using AichmeeLab.Pages.Admin_Pages.Admin_Editor.Article_Inspector.Tags_Inspector
@inject AichmeeLab.Services.TagService.ITagService TagService
@inject AichmeeLab.Services.ImageService.IImageService ImageService;


<div class="inspector-layout">

    <InputText @bind-Value="SelectedArticle.Title" @bind-Value:after="HandleFieldChangedAsync" class="title-input" placeholder="Title. . ."/>
    <InputText @bind-Value="SelectedArticle.Author" @bind-Value:after="HandleFieldChangedAsync" class="author-input" placeholder="Author. . ."/>

    <InputTextArea
    @bind-Value="SelectedArticle.Description"
    @bind-Value:after="HandleFieldChangedAsync"
    class="description-input"
    rows="3"
    placeholder="Description. . ."
    />

    <div class="tags-container">
        <span>Tags: </span>
        @if (SelectedArticle.Tags.Count < 3)
        {
            <button class="add-tag" @onclick="() => _tagsInspectorOpen = true">
                <i class="bi bi-plus-circle"></i>
            </button>
        }

        @if (ArticleTags != null && ArticleTags.Any())
        {
            @foreach (var tag in ArticleTags)
            {
                <button class="article-tag" style="border-color: @tag.PrimaryColor; color:@tag.PrimaryColor;" @onclick='() => RemoveTag(tag)'>
                    <i class="@tag.Icon"> @tag.Name</i>
                    <br/>
                    <span>x</span>
                </button>
            }
        }

    </div>
    <div class="image-container">
        @if (_isUploading)//Seeding
        {
            <span>Uploading. . .</span>

        }
        else if (string.IsNullOrEmpty(SelectedImage.HeaderUrl) && !_isUploading)//Waiting to be seeded
        {

            <label for="header-upload" class="btn-image-action upload-mode">
                <i class="bi bi-pc"></i> Upload from Computer
            </label>

        }
        else
        {
            <h3>Header Preview</h3>
            <img class="header-preview" src="@SelectedImage.HeaderUrl"/>
            <label for="header-upload" class="btn-image-action replace-mode">
                <i class="bi bi-arrow-repeat"></i> Replace from Computer
            </label>

            <InputText @bind-Value="SelectedImage.Description" class="image-description" placeholder="(Optional Note)"/>
        }

        <InputFile id="header-upload" OnChange="CaptureStreamAsync" style="display:none"/>

            
    </div>

    @if (_tagsInspectorOpen)
    {
        <TagsInspector
        OnChange="HandleTags"
        IncomingTags="ArticleTags"
        OnClose="()=> _tagsInspectorOpen = false"
        />
    }
</div>


@code {
    #region ['Public Properties']
    [Parameter]
    public Image SelectedImage { get; set; } = new();
    [Parameter]
    public EventCallback<Image> OnImageChanged { get; set; }
    [Parameter]
    public Article SelectedArticle { get; set; } = new();
    [Parameter]
    public Action? HeaderChanged { get; set; }
    public List<Aichmee.Shared.Tag> ArticleTags { get; set; } = new();
    #endregion

    #region ['Private Properties']
    bool _isUploading { get; set; } = false;
    bool _tagsInspectorOpen { get; set; } = false;

    MemoryStream? _fileBuffer { get; set; }
    string _fileName { get; set; } = string.Empty;
    #endregion 

    protected async override Task OnParametersSetAsync()
    {
        ArticleTags = new();
        if (SelectedArticle.Tags.Any())
        {
            var result = await TagService.GetArticleTags(SelectedArticle.Tags);
            if (result.Data != null && result.Data.Any())
            {
                ArticleTags = new(result.Data);
            }
        }
    }


    #region ['Private Helpers']
    async Task CaptureStreamAsync(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;
        var browserFile = e.File;

        try
        {
            // 1. Capture the stream immediately
            using var browserStream = browserFile.OpenReadStream(10 * 1024 * 1024);
            _fileName = browserFile.Name;

            // 2. Drain it into a MemoryStream right now
            _fileBuffer = new MemoryStream();
            _isUploading = true;
            StateHasChanged();
            await browserStream.CopyToAsync(_fileBuffer);

            // 3. Reset the position to the beginning so the Service can read it
            _fileBuffer.Position = 0;

            var format = e.File.ContentType;
            var buffer = _fileBuffer.ToArray();

            var newImage = new Image();//If the article already has a Db Image we replace it with new object
            newImage.HeaderUrl = newImage.RawImageUrl = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
            newImage.Description = SelectedImage.Description;

            await OnImageChanged.InvokeAsync(newImage);


        }
        catch
        {

        }
        finally
        {
            _isUploading = false;
        }
    }

    async Task HandleFieldChangedAsync() => HeaderChanged?.Invoke();
    public async Task<ServiceResponse<Image>> ImageDbUploadAsync()
    {

        var result = new ServiceResponse<Image>
        {
            Data = null,
            Success = false
        };

        if (_fileBuffer != null)
        {
            _fileBuffer.Position = 0;
            try
            {
                result = await ImageService.UploadImageAsync(_fileBuffer, _fileName, SelectedImage.Description);

                if (result.Success && result.Data != null)
                {
                    return result;
                }
            }
            catch (Exception ex)
            {
                result.Message = $"{ex.Message}";
            }
        }

        result.Message = "Failure to upload Image";
        return result;
    }
    
    void RemoveTag(Aichmee.Shared.Tag incomingTag)
    {
        ArticleTags.Remove(incomingTag);
        HandleTags(ArticleTags);
    }
    void HandleTags(List<Aichmee.Shared.Tag> newTags)
    {
        SelectedArticle.Tags = new(newTags.Select(t => t.Id).ToList());
        ArticleTags = newTags;
        StateHasChanged();
    }
    #endregion
}

