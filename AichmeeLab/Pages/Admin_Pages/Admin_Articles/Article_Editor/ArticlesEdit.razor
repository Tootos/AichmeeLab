@using AichmeeLab.Pages.Admin_Pages.Admin_Articles.Article_Editor.Article_Inspector
@using AichmeeLab.Pages.Admin_Pages.Admin_Articles.Article_Editor.Article_Writer
@using AichmeeLab.Pages.View_Article
@using BootstrapBlazor.Components
@inject IJSRuntime jSRuntime;
@inject AichmeeLab.Services.WriterService.IWriterService WriterService;
@inject AichmeeLab.Services.ImageService.IImageService ImageService;

<div class="editor-layout @(_loading ? "is-loading" : "")">
    <div class="loading-window">
        <div class="loader-layout">
            <div class="spinner-icon"><i class="bi bi-arrow-clockwise"></i></div>
            <div class="service-response">
                <span>Service Response: </span>
                @foreach (var message in _serviceMessages)
                {
                    <span>@message</span>
                }
            </div>

        </div>
    </div>

    @if (_isPreviewMode)
    {
        <button type="button" class="btn btn-outline-secondary" @onclick="HandlePreview">
            <i class="bi bi-arrow-left me-1"></i>
        </button>
        <ViewArticle SelectedArticle="SelectedArticle" HeaderImage="_selectedImage" />
    }
    else
    {
        <div class="writer-layout">
            <div class="inspector-window @(_isHeaderOpen ? "is-open" : "is-closed")">
                <div class="inspector-toggle" @onclick="() => _isHeaderOpen = !_isHeaderOpen">
                    <span><i class="bi bi-image me-2"></i> Meta Data</span>
                    <i class="bi @(_isHeaderOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </div>
                <ArticleInspector @ref="_articleInspector" SelectedArticle="SelectedArticle" SelectedImage="_selectedImage"
                                  OnImageChanged="@(img => _selectedImage = img)" />
            </div>
            <div class="writer-window " @key="@(SelectedArticle.Id ?? "new article")">
                <ArticleWriter @ref="_articleWriter" SelectedArticle="SelectedArticle" />
            </div>

        </div>


        <div class="action-container">
            <EditForm Model="SelectedArticle" OnValidSubmit="SaveEntryAsync" class="form-wrapper">
                <DataAnnotationsValidator />

                <ValidationMessage For="@(() => SelectedArticle.Title)" />
                <ValidationMessage For="@(() => SelectedArticle.Description)" />
                <ValidationMessage For="@(() => SelectedArticle.Author)" />
                <button type="button" class="btn btn-primary" @onclick="HandlePreview">
                    <i class="bi bi-eye"></i>Preview
                </button>
                <button type="button" class="btn btn-primary" @onclick="ResetEditorAsync">
                    <i class="bi-arrow-clockwise"></i> Create New
                </button>

                <div class="form-check form-switch visibility-control">
                    <input type="checkbox" class="btn-check" id="vSwitch" @bind="_isVisible" autocomplete="off">
                    <label class="btn @(_isVisible ? "btn-success" : "btn-outline-secondary") w-100 py-2 fw-bold"
                           for="vSwitch">
                        <i class="bi @(_isVisible ? "bi-eye-fill" : "bi-eye-slash") me-1"></i>
                        @(_isVisible ? "VISIBLE" : "HIDDEN")
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-2">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Save Article
                </button>

                @if (!string.IsNullOrEmpty(SelectedArticle.Id))
                {
                    <button type="button" class="btn btn-outline-danger btn-sm w-100 border-0 mt-2"
                            @onclick="DeleteFromDbAsync">
                        Delete from Database
                    </button>
                }
            </EditForm>
        </div>

    }

</div>
@code {
    ArticleWriter? _articleWriter;
    ArticleInspector? _articleInspector;

    bool _loading { get; set; } = false;
    List<string> _serviceMessages = new List<string>();

    [Parameter] public Article SelectedArticle { get; set; } = new Article();
    Image _selectedImage { get; set; } = new Image();
    [Parameter] public EventCallback OnReady { get; set; }
    [Parameter] public EventCallback<Article?> OnChange { get; set; }
    bool _isPreviewMode { get; set; } = false;
    bool _isHeaderOpen { get; set; } = false;
    bool _isVisible { get; set; }

    protected override void OnInitialized()
    {
        ImageService.Collages.Clear();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SelectedArticle.HeaderImageId))
        {
            var result = await ImageService.GetImageAsync(SelectedArticle.HeaderImageId);
            if (result.Success && result.Data != null)
                _selectedImage = result.Data;
        }

        _isVisible = SelectedArticle.IsVisible;
    }

    //Save Article
    public async Task SaveEntryAsync()
    {
        _serviceMessages.Clear();
        string jsMessage = "Entry Saved.";
        try
        {
            // 1. Check if Page Elements are initialized
            if (_articleWriter == null || _articleInspector == null)
                return;

            //Make a new Article class to take the new data so Parameter SelectedArticle doesn't trigger lifecycle methods.
            var savedArticle = new Article
            {
                Id = SelectedArticle.Id,
                Title = SelectedArticle.Title,
                Description = SelectedArticle.Description,
                Author = SelectedArticle.Author,
                DatePublished = SelectedArticle.DatePublished,
                Contact = SelectedArticle.Contact,
                HeaderImageId = SelectedArticle.HeaderImageId
            };

            //ALWAYS EXPORT THE CONTENT LIST FIRST OR ELSE THE CONTENT WILL BE ERASED AFTER STATEHASCHANGED()
            _articleWriter.RemoveEmptyCollages();
            var contentBlocks = _articleWriter.ExportList();
            var collagesToUpload = ImageService.Collages.ToList();

            // 2. Lock the editor for the user
            _loading = true;
            StateHasChanged();

            // 3. Handle Image Change
            // Case 1: If it doesn't have an Id it's a new image and we will create an entry
            if (string.IsNullOrEmpty(_selectedImage.Id))
            {
                var imageResponse = await _articleInspector.ImageDbUploadAsync();
                if (!imageResponse.Success || string.IsNullOrEmpty(imageResponse?.Data?.Id))
                {
                    await jSRuntime.InvokeVoidAsync("alert", imageResponse.Message ?? "Failed uploading image.");
                    _loading = false;
                    StateHasChanged();
                    return;

                }
                _selectedImage = imageResponse.Data;
                _serviceMessages.Add(imageResponse.Message);

                savedArticle.HeaderImageId = imageResponse.Data.Id;
            }
            //Case 2: If it isn't a new image then we will just update the information like description
            else
            {
                var updateImageResponse = await ImageService.UpdateImageAsync(_selectedImage);
                _serviceMessages.Add(updateImageResponse.Message);
            }
            StateHasChanged();

            //4. Update the Article information(Id, Title, Date, etc...)
            var response = await WriterService.UpdateArticleInfoAsync(savedArticle);
            if (response.Success && response.Data != null && !string.IsNullOrEmpty(response.Data.Id))
            {

                savedArticle = response.Data;
                _serviceMessages.Add(response.Message);
                StateHasChanged();
                //5. Update Content blocks
                @* var textBlocks = contentBlocks.Where(c=>c.Type == "text").ToList();
                savedArticle.ContentBlocks = new List<ContentBlock>(); *@
                savedArticle.ContentBlocks.AddRange(contentBlocks.ToList());
                // Remove the collages stored in the Image service so no duplicates are made
                savedArticle.ContentBlocks.RemoveAll(b => ImageService.Collages.ContainsKey(b.Step));

                var paragraphResponse =
                await WriterService.UpdateArticleParagraphsAsync(savedArticle);

                _serviceMessages.Add(paragraphResponse.Message);
                StateHasChanged();

                //6. Upload all collage photos
                for (int i = 0; i < collagesToUpload.Count; i++)
                {
                    var key = collagesToUpload[i].Key;
                    var value = collagesToUpload[i].Value;

                    var collageResponse = await ImageService
                    .UploadImagesBulk(savedArticle.Id, key, value);
                    if (collageResponse.Success && collageResponse.Data != null)
                    {

                        savedArticle.ContentBlocks.Add(new ContentBlock{Step = key,Content = collageResponse.Data,Type = "collage" });

                        @* var newBlock = new ContentBlock { Step = collagesToUpload[i].Key, Type = "collage", Content = collageResponse.Data };

                        savedArticle.ContentBlocks = savedArticle.ContentBlocks
                       .Select(b => b.Step == newBlock.Step ? newBlock : b)
                       .ToList(); *@

                        _serviceMessages.Add($"Collage ({i + 1}/{collagesToUpload.Count}) posted.");
                    }
                    else
                    {
                        _serviceMessages.Add($"Collage ({i + 1}/{collagesToUpload.Count}) failed to post.");
                    }

                    StateHasChanged();

                }

                

                var updatedVisibility = new Dictionary<string, bool>();
                updatedVisibility.Add(savedArticle.Id, _isVisible);

               
                //7. Update Visibility
                var visibilityResult = await WriterService.UpdateVisibilityAsync(updatedVisibility);

                if (visibilityResult?.Data != null && visibilityResult.Data > 0)
                {
                    _serviceMessages.Add(visibilityResult.Message);
                    savedArticle.IsVisible = _isVisible;
                    StateHasChanged();

                }

                //8. Closing
                ImageService.Collages.Clear();

                savedArticle.ContentBlocks = savedArticle.ContentBlocks.OrderBy(c => c.Step).ToList();
                ImageService.Collages.Clear();
                await OnChange.InvokeAsync(savedArticle);
            }
            else
            {

                jsMessage = string.IsNullOrEmpty(response.Message) ? "Failed Save Operation" : response.Message;
            }
        }
        catch (Exception ex)
        {
            jsMessage = ex.Message;
        }
        finally
        {
            //COMPLETED, DELIVER MESSAGE
            await jSRuntime.InvokeVoidAsync("alert", jsMessage);
            _loading = false;
        }
    }

    async Task ResetEditorAsync()
    {
        var article = new Article();
        _selectedImage = new Image();
        ImageService.Collages.Clear();

        await OnChange.InvokeAsync(article);
        StateHasChanged();
    }

    void HandlePreview()
    {
        if (_articleWriter == null) return;
        _isPreviewMode = !_isPreviewMode;
        if (_isPreviewMode)

            SelectedArticle.ContentBlocks = _articleWriter.ExportList();

        StateHasChanged();
    }

    async Task DeleteFromDbAsync()
    {
        if (string.IsNullOrEmpty(SelectedArticle.Id)) return;

        var response = await WriterService.DeleteArticleAsync(SelectedArticle.Id);
        await jSRuntime.InvokeVoidAsync("alert", response.Message);

        await ResetEditorAsync();

    }
}