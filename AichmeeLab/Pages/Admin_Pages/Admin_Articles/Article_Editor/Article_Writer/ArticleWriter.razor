@using AichmeeLab.Pages.Admin_Pages.Admin_Articles.Article_Editor.Article_Writer.Images_Sidepanel
@using AichmeeLab.Pages.Admin_Pages.Admin_Articles.Article_Editor.Article_Writer.Photo_Collage
@using AichmeeLab.Services.ImageService
@using BootstrapBlazor.Components
@using Markdig
@using System.Runtime.CompilerServices
@inject IJSRuntime jSRuntime;
@inject AichmeeLab.Services.ImageService.IImageService ImageService;

<div class="writer-canvas">
    @foreach (var block in WriterData.OrderBy(x => x.Step))
    {

        
        var id = string.IsNullOrEmpty(SelectedArticle.Id) ? "new" : SelectedArticle.Id;
        var domId = $"{block.Type}-{block.Step}-{id}";

        

        @switch (block.Type)
        {
            case "text":
                var menuId = $"menu-{block.Step}-{id}";
                <div @key="@domId" class="text-block-container" @onmouseover="() => _activeDomId = domId">
                    <div id="@menuId" class="side-menu-wrapper">
                        <button class="options-prompt" type="button">
                            <i class="bi bi-list"></i> </button>

                            <div class="options-menu">
                                <button @onclick='() => ApplyStyleAsync("h1")' title="H1">H1</button>
                                <button @onclick='() => ApplyStyleAsync("h3")' title="H3">H3</button>
                                <button @onclick='() => ApplyStyleAsync("p")' title="Text">P</button>
                                <button @onclick='() => ApplyStyleAsync("ol")' title="Ordered List">1.</button>
                                <button @onclick='() => ApplyStyleAsync("ul")' title="Bullet List">•</button>
                                <button @onclick="AddCollageAsync">Pic</button>
                            </div>
                        </div>

                        <div @key="@domId" id="@domId" contenteditable="true" class="simple-writer"
                             @oninput='() => UpdatePosition(domId, menuId)' @onclick='() => UpdatePosition(domId, menuId)'
                             @onkeyup='() => UpdatePosition(domId, menuId)' @onblur="() => SyncContent(block, domId)"
                             suppressContentEditableWarning="true" spellcheck="false">


                        </div>
                    </div>
                    break;
                case "collage":
                        <PhotoCollage @key="domId" DomId="@domId" IncomingStep="@block.Step" OnCollageChange="HandleCollageUpdatedAsync"
                                      IncomingCollage="block.Content" OpenImageSidePanel="(imgs)=>HandleCollageEditRequest(block.Step,imgs)"
                                      OnCollageDestroyed="HandleCollageDestroyed" />
                        break;
                    }
                }
                <div id="inline-toolbar" class="inline-toolbar">
                    <button @onclick='() => ApplyInlineAsync("bold")' title="Bold"><b>B</b></button>
                    <button @onclick='() => ApplyInlineAsync("italic")' title="Italic">〰</button>
                    <button @onclick='() => ApplyInlineAsync("link")' title="Link"><i class="bi bi-link-45deg"></i></button>
                </div>
        </div>

<ImagesSidepanel @ref="_imagesSidepanel" OnClose="() => _isSidePanelOpen = false"
                 OnImagesSelected="HandleListFetchAsync" />

@code {

    

    ImagesSidepanel _imagesSidepanel = null;

    bool _isSidePanelOpen { get; set; } = false;
    [Parameter]
    public Article SelectedArticle { get; set; } = new Article();
    List<ContentBlock> WriterData { get; set; } = new List<ContentBlock>();
    string _activeDomId = string.Empty;
    bool _loadContent { get; set; }

    string _currentArticleId { get; set; } = string.Empty;

    public class CollageUpdateResult
    {
        public int Step { get; set; }
        public List<Image> Images { get; set; } = new();
    }


    protected override void OnParametersSet()
    {
        if (_currentArticleId != SelectedArticle.Id)
        {
            _currentArticleId = SelectedArticle.Id;
            if (SelectedArticle.ContentBlocks.Count > 0)
            {
                WriterData = SelectedArticle.ContentBlocks
                .OrderBy(w => w.Step).ToList();

            }
            else
            {
                WriterData = new List<ContentBlock>();
                WriterData.Add(new ContentBlock
                {
                    Step = WriterData.Count,
                    Type = "text",
                    Content = new List<string> { "<p><br></p>" }
                });
            }
            _loadContent = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jSRuntime.InvokeVoidAsync("writerEngine.initInlineToolbar");
        }

        if (_loadContent)
        {
            var id = string.IsNullOrEmpty(SelectedArticle.Id) ? "" : SelectedArticle.Id;
            foreach (var block in WriterData.Where(b => b.Type == "text"))
            {
                var domId = $"text-{block.Step}-{id}";
                var htmlContent = block.Content.FirstOrDefault() ?? "<p><br></p>";
                await jSRuntime.InvokeVoidAsync("writerEngine.loadContent", domId, htmlContent);
            }
            _loadContent = false;
        }
    }

    async Task SyncContent(ContentBlock block, string domId)
    {
        // 1. Get the raw HTML from the contenteditable div
        var html = await jSRuntime.InvokeAsync<string>("writerEngine.getHtml", domId);

        // 2. Save the HTML to your block (or convert to Markdown here)
        // For now, let's store the HTML so your view doesn't break
        block.Content = new List<string> { html };
    }

    async Task ApplyStyleAsync(string type)
    {
        if (string.IsNullOrEmpty(_activeDomId)) return;

        if (type == "ol" || type == "ul")
            await jSRuntime.InvokeVoidAsync("writerEngine.applyList", _activeDomId, type);
        else
            await jSRuntime.InvokeVoidAsync("writerEngine.applyBlockStyle", _activeDomId, type);
        var block = WriterData.FirstOrDefault(x => $"text-{x.Step}-{SelectedArticle.Id}" == _activeDomId);
        if (block != null) await SyncContent(block, _activeDomId);
    }

    async Task ApplyInlineAsync(string type)
    {
        if (string.IsNullOrEmpty(_activeDomId)) return;

        switch (type)
        {
            case "bold":
                await jSRuntime.InvokeVoidAsync("writerEngine.applyInlineStyle", _activeDomId, "bold");
                break;
            case "italic":
                await jSRuntime.InvokeVoidAsync("writerEngine.applyInlineStyle", _activeDomId, "italic");
                break;
            case "link":
                await jSRuntime.InvokeVoidAsync("writerEngine.applyLink", _activeDomId);
                break;
        }
    }

    async Task UpdatePosition(string domId, string menuId)
    {
        await jSRuntime.InvokeVoidAsync("writerEngine.updateMenuPosition", domId, menuId);
    }


    void HandleCollageEditRequest(int step, List<Image> images)
    {
        if (_imagesSidepanel == null) return;
        _isSidePanelOpen = true;
        _imagesSidepanel.ChangeCollage(step, images);
    }

    async Task HandleListFetchAsync(ImagesSidepanel.CollageUpdateResult result)
    {
        if (result.Images == null || !result.Images.Any()) return;

        // 1. Fetch the PhotoCollage Block from the local rendering list
        var targetBlock = WriterData.FirstOrDefault(x => x.Step == result.Step);

        if (targetBlock != null)
        {
            // 2. Filter for uniqueness based on Id or RawImageUrl
            var uniqueBase64Strings = result.Images
                .Select(i => !string.IsNullOrEmpty(i.Id) ? i.Id : i.RawImageUrl)
                .Distinct()
                .ToList();

            // 3. Assign the decoupled image string list to the local content block
            targetBlock.Content = uniqueBase64Strings;

            StateHasChanged();
        }
    }


    async Task AddCollageAsync()
    {
        if (string.IsNullOrEmpty(_activeDomId)) return;

        var currentBlock = WriterData.FirstOrDefault(x =>
            $"text-{x.Step}-{(string.IsNullOrEmpty(SelectedArticle.Id) ? "new" : SelectedArticle.Id)}" == _activeDomId);
        if (currentBlock == null) return;

        // Get the HTML after the cursor
        var trailingHtml = await jSRuntime.InvokeAsync<string>("writerEngine.splitContent", _activeDomId);

        // Sync the current block
        await SyncContent(currentBlock, _activeDomId);

        // Find the block immediately following this one, IF it exists AND IS text block
        var nextBlock = WriterData.FirstOrDefault(x => x.Step == currentBlock.Step + 1 && x.Type == "text");

        if (nextBlock != null)
        {
            // Case A
            // Push trailing HTML to the start of the existing next block
            var existingContent = nextBlock.Content?.FirstOrDefault() ?? "";
            nextBlock.Content = new List<string> { trailingHtml + existingContent };

            foreach (var b in WriterData.Where(x => x.Step > currentBlock.Step))
            {
                b.Step += 1;
            }

            WriterData.Add(new ContentBlock
            {
                Step = currentBlock.Step + 1,
                Type = "collage"
            });
        }
        else
        {
            // Case B
            // Shift by +2 to make room for Collage AND the new Text block
            foreach (var b in WriterData.Where(x => x.Step > currentBlock.Step))
            {
                b.Step += 2;
            }

            WriterData.Add(new ContentBlock
            {
                Step = currentBlock.Step + 1,
                Type = "collage",
                Content = new List<string>(),
            });

            WriterData.Add(new ContentBlock
            {
                Step = currentBlock.Step + 2,
                Type = "text",
                Content = new List<string> { string.IsNullOrWhiteSpace(trailingHtml) ? "<p><br></p>" : trailingHtml }
            });
        }

        _loadContent = true;
        StateHasChanged();
    }

    public async Task HandleCollageUpdatedAsync(ContentBlock contentBlock)
    {
        if (contentBlock == null) return;

        var selectedBlock = WriterData.Find(c => c.Step == contentBlock.Step);

        if (selectedBlock == null) return;

        selectedBlock.Content = contentBlock.Content;

        selectedBlock.Type = "collage";

        StateHasChanged();
    }

void HandleCollageDestroyed(int destroyedCollageStep)
{
    // 1. Instantly drop the targeted collage block out of our layout list
    WriterData.RemoveAll(c => c.Step == destroyedCollageStep && c.Type == "collage");
    
    // 2. Clear out its recorded state tracking entry from the shared service
    ImageService.Collages.Remove(destroyedCollageStep);

    // 3. Shift every single block sitting below the deleted collage backward by 1
    foreach (var b in WriterData.Where(c => c.Step > destroyedCollageStep))
    {
        b.Step--;
    }

    // 4. Shift corresponding indices inside our image tracking system cleanly
    ImageService.Collages = ImageService.Collages.ToDictionary(
        kvp => kvp.Key > destroyedCollageStep ? kvp.Key - 1 : kvp.Key,
        kvp => kvp.Value
    );

    // 5. Look up neighboring blocks to see if we left two text fields touching
    var previousBlock = WriterData.FirstOrDefault(c => c.Step == destroyedCollageStep - 1);
    var currentBlock = WriterData.FirstOrDefault(c => c.Step == destroyedCollageStep);

    if (previousBlock != null && previousBlock.Type == "text" &&
        currentBlock != null && currentBlock.Type == "text")
    {
        // Safely extract and concatenate strings
        string firstLine = previousBlock.Content?.FirstOrDefault() ?? "";
        string secondLine = currentBlock.Content?.FirstOrDefault() ?? "";

        previousBlock.Content = new List<string> { $"{firstLine}<br>{secondLine}" };

        // Remove the redundant current block that we just merged upwards
        WriterData.Remove(currentBlock);

        // Since another block vanished, shift every block past this point down by 1 more step
        foreach (var b in WriterData.Where(c => c.Step > destroyedCollageStep))
        {
            b.Step--;
        }

        // Keep the image service dictionary structurally synchronized with the second text shift
        ImageService.Collages = ImageService.Collages.ToDictionary(
            kvp => kvp.Key > destroyedCollageStep ? kvp.Key - 1 : kvp.Key,
            kvp => kvp.Value
        );
    }

    // 6. Signal the canvas wrapper to re-initialize layout view fields
    _loadContent = true;
    StateHasChanged();
}


    //Method to remove empty collages from the article during Save
    public void RemoveEmptyCollages()
    {
        // Find all collage blocks that have no Images
        var emptyCollages = WriterData
            .Where(c => c.Type == "collage"
            && (c.Content == null
            || c.Content.Count == 0
            || c.Content.FirstOrDefault() == "<p><br></p>"
            || string.IsNullOrEmpty(c.Content.FirstOrDefault())))
            .OrderByDescending(c => c.Step) // Crucial: Process back-to-front!
            .ToList();

        if (!emptyCollages.Any()) return;

        foreach (var emptyBlock in emptyCollages)
        {
            int targetStep = emptyBlock.Step;

            // Remove the empty block from our local list instance
            WriterData.Remove(emptyBlock);

            // Shift every block sitting after this removed block back by 1 step
            WriterData
                .Where(c => c.Step > targetStep)
                .ToList()
                .ForEach(c => c.Step--);

            // Synchronize your shared state tracking records in the ImageService
            ImageService.Collages.Remove(targetStep);
            ImageService.Collages = ImageService.Collages.ToDictionary(
                kvp => kvp.Key > targetStep ? kvp.Key - 1 : kvp.Key,
                kvp => kvp.Value
            );

            var previousBlock = WriterData.FirstOrDefault(c => c.Step == targetStep - 1);
            var currentBlock = WriterData.FirstOrDefault(c => c.Step == targetStep);

            if (previousBlock != null && previousBlock.Type == "text" &&
            currentBlock != null && currentBlock.Type == "text")
            {
                // Combine the raw HTML content strings safely
                if (previousBlock.Content != null && currentBlock.Content != null && currentBlock.Content.Count > 0)
                {
                    string firstLine = previousBlock.Content.FirstOrDefault() ?? "";
                    string secondLine = currentBlock.Content.FirstOrDefault() ?? "";

                    previousBlock.Content = new List<string> { $"{firstLine}<br>{secondLine}" };
                }

                WriterData.Remove(currentBlock);

                WriterData
                    .Where(c => c.Step >= targetStep)
                    .ToList()
                    .ForEach(c => c.Step--);

                ImageService.Collages = ImageService.Collages.ToDictionary(
                    kvp => kvp.Key > targetStep ? kvp.Key - 1 : kvp.Key,
                    kvp => kvp.Value
                );
            }
        }


        _loadContent = true;
        SelectedArticle.ContentBlocks = WriterData.OrderBy(c => c.Step).ToList();
        StateHasChanged();
    }


    public List<ContentBlock> ExportList()
    {

        return WriterData
                    .OrderBy(x => x.Step)
                    .Select(block => new ContentBlock
                    {
                        Step = block.Step,
                        Type = block.Type,
                        Content = block.Content
                    })
                    .ToList();
    }
}
