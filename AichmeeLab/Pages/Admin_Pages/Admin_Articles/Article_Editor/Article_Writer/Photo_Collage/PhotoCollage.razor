@inject AichmeeLab.Services.ImageService.IImageService ImageService;

<div class="collage-container">
    @if (DisplayImages != null && DisplayImages.Count > 0)
    {
        <div class="collage-carousel">
            <div class="collage-preview-state">
                @if (DisplayImages.Count > 1)
                {
                    <button class="nav-arrow left" @onclick="PreviousImage">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                }

                <div class="image-viewer">
                    <div class="image-action-buttons">
                        <button class="change-button" @onclick="OpenSidepanel">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button class="delete-button" @onclick="DestroyCollage">
                            <i class="bi bi-dash-circle-fill"></i>
                        </button>
                    </div>

                    @{
                        var currentImg = DisplayImages[_currentIndex];
                        var displayUrl = string.IsNullOrEmpty(currentImg.HeaderUrl)
                                         ? currentImg.RawImageUrl
                                         : currentImg.HeaderUrl;
                    }
                    <img src="@displayUrl" class="active-collage-img" />

                    <div class="image-description">
                        <input type="text" value="@currentImg.Description"
                               @onchange="(e) => UpdateImageDescription(currentImg, e.Value?.ToString())"
                               placeholder="Add a caption for this photo..." class="description-input" />
                    </div>

                    <div class="image-counter">@(_currentIndex + 1) / @(DisplayImages.Count)</div>
                </div>

                @if (DisplayImages.Count > 1)
                {
                    <button class="nav-arrow right" @onclick="NextImage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="collage-empty-state" @onclick="OpenSidepanel">
            <i class="bi bi-images"></i>
            <span>Click to add photos to collage</span>
            <button class="delete-button" @onclick="DestroyCollage" @onclick:stopPropagation>
                <i class="bi bi-dash-circle-fill"></i>
            </button>
        </div>
    }
</div>

@code {
    int _currentIndex = 0;
    [Parameter] public string DomId { get; set; } = string.Empty;
    [Parameter] public List<string> IncomingCollage { get; set; } = null;
    [Parameter] public int IncomingStep { get; set; }

    List<string> _lastIncomingCollage { get; set; } = new();
    List<Image> DisplayImages { get; set; } = new();

    [Parameter] public EventCallback<ContentBlock> OnCollageChange { get; set; }
    [Parameter] public EventCallback<int> OnCollageDestroyed { get; set; }
    [Parameter] public EventCallback<List<Image>> OpenImageSidePanel { get; set; }

    private int _lastProcessedStep = -1;

    protected override async Task OnParametersSetAsync()
    {
        bool stepHasChanged = _lastProcessedStep != IncomingStep;
        if (stepHasChanged && _lastProcessedStep != -1)
        {
            ImageService.Collages.Remove(_lastProcessedStep);
        }
        _lastProcessedStep = IncomingStep;

        if (IncomingCollage == null || IncomingCollage.Count == 0)
        {
            DisplayImages.Clear();
            ImageService.Collages.Remove(IncomingStep);
            _lastIncomingCollage.Clear();
            _currentIndex = 0;
            return;
        }

        if (!stepHasChanged && _lastIncomingCollage.SequenceEqual(IncomingCollage)) return;

        _lastIncomingCollage = new List<string>(IncomingCollage);
        DisplayImages.Clear();

        foreach (var imageId in IncomingCollage)
        {
            if (imageId.StartsWith("data:image"))
            {
                DisplayImages.Add(new Image
                {
                    Id = string.Empty,
                    RawImageUrl = imageId,
                    HeaderUrl = imageId
                });
            }
            else
            {
                var response = await ImageService.GetImageAsync(imageId);
                if (response?.Success == true && response.Data != null)
                    DisplayImages.Add(response.Data);
            }
        }

        if (DisplayImages.Any())
        {
            ImageService.Collages[IncomingStep] = new List<Image>(DisplayImages);
        }

        if (_currentIndex >= DisplayImages.Count)
            _currentIndex = Math.Max(0, DisplayImages.Count - 1);
    }

    async Task OpenSidepanel()
    {
        await OpenImageSidePanel.InvokeAsync(DisplayImages);
    }

    async Task UpdateImageDescription(Image img, string? newDescription)
    {
        img.Description = newDescription ?? string.Empty;

        // Notify parent writer canvas that structural data contents inside this block mutated
        var updatedBlock = new ContentBlock
        {
            Step = IncomingStep,
            Type = "collage",
            Content = IncomingCollage // Keeps current image references intact
        };
        await OnCollageChange.InvokeAsync(updatedBlock);
    }

    void PreviousImage()
    {
        if (DisplayImages == null || DisplayImages.Count == 0) return;
        _currentIndex = (_currentIndex == 0) ? DisplayImages.Count - 1 : _currentIndex - 1;
    }

    void NextImage()
    {
        if (DisplayImages == null || DisplayImages.Count == 0) return;
        _currentIndex = (_currentIndex == DisplayImages.Count - 1) ? 0 : _currentIndex + 1;
    }

    async Task DestroyCollage()
    {
        await OnCollageDestroyed.InvokeAsync(IncomingStep);
    }
}