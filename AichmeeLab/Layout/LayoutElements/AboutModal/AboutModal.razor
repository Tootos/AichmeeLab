@inject AichmeeLab.Services.ImageService.IImageService ImageService

@if (IsVisible)
{
    <div class="about-window">
        <div class="about-layout">
            <button class="close-btn" @onclick="Close">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="about-content">
                <div class="left-row">
                    <img src=@ImageService.AboutImage />
                </div>

                <div class="right-row">
                    <span href="aichmeelab@gmail.com">
                        <i class="bi bi-envelope"></i> aichmeelab@gmail.com</span>
                        <a href="https://github.com/Tootos">
                            <i class="bi bi-github"></i> GitHub</a>
                            <div class="quote">
                                <p>
                                    "Welcome to my personal sandbox. This space is dedicated to documenting the works, lives, and thoughts of my contributors and myself. Still a work in progress."
                                </p>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close() => await OnClose.InvokeAsync();
}