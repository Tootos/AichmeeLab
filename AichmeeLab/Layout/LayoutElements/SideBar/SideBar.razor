@using AichmeeLab.Layout.LayoutElements.Admin_Widget
@inject NavigationManager NavigationManager
@inject AichmeeLab.Services.TagService.ITagService TagService
@implements IDisposable
@inject IJSRuntime JS

<aside class="sidebar-container @(_isCollapsed ? "collapsed" : "")">
    <div class="sidebar-layout">

        <button class="sidebar-toggle" @onclick="ToggleSidebar">
            <i class="bi @(_isCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
        </button>

        <div class="sidebar-header">
            <i class="bi bi-home"/>
        </div>

        <nav class="sidebar-nav">
            <button class="nav-text-btn @(IsActive(null) ? "active" : "")" @onclick='() => NavigateTo("/")'>
                <i class="bi bi-house"></i> Feed
            </button>

            

            @if (_selectionTags == null || _selectionTags.Count == 0)
            {
                <span>Loading tags. . .</span>
            }
            else
            {
                <span class="nav-text-hint">Filter by tags</span>
                foreach (var tag in _selectionTags)
                {
                    <button class="nav-text-btn @(IsActive(tag.Name) ? "active" : "")" @onclick='() => NavigateTo($"/?tag={tag.Name}")'>
                        <i class="@tag.Icon">@tag.Name</i>
                    </button>
                }
                
            }
        </nav>

        <button class="btn btn-refresh" @onclick="RefreshTags">
            <i class="bi bi-arrow-clockwise spin-icon"></i>
        </button>

        @if (IsAdmin)
        {
            <div class="admin-window">
                <AdminWidget/>
            </div>

        }

        <div class="sidebar-footer">
            <button class="nav-text-btn" @onclick="OpenAboutAsync">
                <i class="bi bi-person-raised-hand"></i> About
            </button>
        </div>

    </div>
</aside>


@code {
    #region "[ Properties ]"

    List<Tag> _selectionTags = new();
    bool _isCollapsed { get; set; } = false;
    [Parameter]
    public bool IsAdmin { get; set; } = false;
    [Parameter]
    public EventCallback OpenAboutModal { get; set; }

    bool _isMobileDevice { get; set; } = false;

    SelectedTag _activeType { get; set; } = SelectedTag.Post;
    #endregion

    #region "[ Lifecycle Methods ]"
    protected override async Task OnInitializedAsync()
    {
        if (_selectionTags == null || _selectionTags.Count == 0)
        {
            await GetTagRecommendations();
        }
        
        NavigationManager.LocationChanged += OnLocationChanged;
        
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _isMobileDevice = await JS.InvokeAsync<bool>("isMobileDevice");
    }

    #endregion

    #region "[ Helper Methods ]"
    private void NavigateTo(string targetUrl)
    {

        NavigationManager.NavigateTo(targetUrl);
        if (_isMobileDevice)
            ToggleSidebar();
    }

    async Task OpenAboutAsync() => await OpenAboutModal.InvokeAsync();
    public void ToggleSidebar() => _isCollapsed = !_isCollapsed;
    string GetButtonClass(SelectedTag type) =>
        _activeType == type ? "active" : "";



    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool IsActive(string? incomingTag)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

        var queryStrings = QueryHelpers.ParseQuery(uri.Query);

        if (queryStrings.TryGetValue("tag", out var actualTag))
        {
            return string.Equals(actualTag, incomingTag, StringComparison.OrdinalIgnoreCase);
        }
        return incomingTag == null;
    }

    async Task RefreshTags()
    {
        await GetTagRecommendations();
    }

    async Task GetTagRecommendations()
    {
        var result = await TagService.GetRecommendedTags(_selectionTags);
        if (result.Success && result?.Data != null && result.Data.Any())
        {
            _selectionTags = result.Data;
    
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
    #endregion
}